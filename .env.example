# Optional. Without a key set, the app works fully except the
# "AI-interpreted findings" section and the chat box, which show a note instead.
# Get keys at https://console.groq.com. Add as many as you want for automatic fallback.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# Secondary fallback path via OpenRouter. This is not direct OpenAI access.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Defaults to openai/gpt-oss-120b (Groq's production tier) if unset.
# qwen/qwen3-32b is a one-line swap - see docs/architecture.md for the
# production-vs-preview tier distinction before depending on it.
GROQ_MODEL=openai/gpt-oss-120b
